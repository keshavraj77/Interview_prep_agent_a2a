# Google API Configuration
GOOGLE_API_KEY=your_google_api_key_here
MODEL_SOURCE=google # Options: 'google' or 'local'

# Local LLM Configuration (for MODEL_SOURCE=local)
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL_NAME=local-model # Model name from LM Studio
LOCAL_LLM_API_KEY=not-needed # LM Studio doesn't require API key, but OpenAI client needs it
LOCAL_LLM_TEMPERATURE=0.3

# A2A Configuration
BASE_API_URL=http://localhost:8000
A2A_CALLBACK_TOKEN=your_jwt_token_here

# Push Notification Configuration
ENABLE_PUSH_NOTIFICATIONS=true
PUSH_NOTIFICATION_MODE=multi_turn
PROCESSING_DELAY_SECONDS=5
CALLBACK_TIMEOUT_SECONDS=60
WEBHOOK_SIGNATURE_SECRET=your_webhook_secret

# Web Search Configuration
ENABLE_WEB_SEARCH=true
SEARCH_RESULTS_LIMIT=5